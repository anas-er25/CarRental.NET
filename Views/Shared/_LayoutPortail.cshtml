<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarRental</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Nunito:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --navy:#0F2044; --navy-light:#1a3260; --orange:#FF6B2B; --orange-light:#FF8C55;
            --cream:#FAFAF7; --white:#FFFFFF;
            --gray-50:#F8F9FC; --gray-100:#EEF0F6; --gray-200:#DDE1EE;
            --gray-400:#9BA3BF; --gray-600:#5C6484; --text:#1A2240;
            --radius:14px; --radius-sm:8px;
            --shadow-sm:0 1px 3px rgba(15,32,68,.08); --shadow:0 4px 16px rgba(15,32,68,.10);
            --shadow-lg:0 12px 40px rgba(15,32,68,.14);
        }
        *{box-sizing:border-box;margin:0;padding:0}
        body{font-family:'Nunito',sans-serif;background:var(--gray-50);color:var(--text)}

        /* NAV */
        .pub-nav{background:var(--white);border-bottom:1px solid var(--gray-200);position:sticky;top:0;z-index:200;box-shadow:var(--shadow-sm)}
        .pub-nav .container{display:flex;align-items:center;gap:20px;padding:0 24px;height:66px}
        .nav-brand{display:flex;align-items:center;gap:10px;text-decoration:none;flex-shrink:0}
        .nav-brand-icon{width:38px;height:38px;background:linear-gradient(135deg,var(--orange),#ff8444);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:1rem;box-shadow:0 3px 10px rgba(255,107,43,.3)}
        .nav-brand-text{font-family:'Playfair Display',serif;font-size:1.15rem;font-weight:800;color:var(--navy)}
        .nav-links{display:flex;align-items:center;gap:4px;flex:1;justify-content:center}
        .nav-links a{padding:7px 16px;border-radius:8px;font-size:.88rem;font-weight:600;color:var(--gray-600);text-decoration:none;transition:all .2s ease}
        .nav-links a:hover{color:var(--navy);background:var(--gray-100)}
        .nav-links a.active{color:var(--orange);background:#FFF7ED}
        .nav-actions{display:flex;align-items:center;gap:10px;flex-shrink:0}
        .btn-nav-login{padding:8px 18px;border-radius:var(--radius-sm);font-size:.85rem;font-weight:700;background:var(--gray-100);color:var(--navy);border:1.5px solid var(--gray-200);text-decoration:none;transition:all .2s ease;display:flex;align-items:center;gap:6px}
        .btn-nav-login:hover{background:var(--gray-200);color:var(--navy)}
        .btn-nav-primary{padding:8px 18px;border-radius:var(--radius-sm);font-size:.85rem;font-weight:700;background:linear-gradient(135deg,var(--orange),#ff8444);color:#fff;border:none;text-decoration:none;transition:all .2s ease;display:flex;align-items:center;gap:6px;box-shadow:0 2px 10px rgba(255,107,43,.25)}
        .btn-nav-primary:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(255,107,43,.35);color:#fff}
        .client-badge{display:flex;align-items:center;gap:8px;padding:6px 14px;background:linear-gradient(135deg,#ECFDF5,#D1FAE5);border:1px solid #A7F3D0;border-radius:20px;font-size:.82rem;font-weight:700;color:#065F46}
        .client-avatar{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,var(--navy),var(--navy-light));display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:800;color:#fff}

        /* TOAST */
        .toast-wrap{position:fixed;top:80px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px}
        .toast-item{padding:12px 18px;border-radius:var(--radius-sm);font-size:.88rem;font-weight:700;display:flex;align-items:center;gap:10px;box-shadow:var(--shadow-lg);animation:slideIn .3s ease}
        .toast-success{background:#ECFDF5;color:#059669;border:1px solid #A7F3D0}
        .toast-error{background:#FEF2F2;color:#DC2626;border:1px solid #FECACA}
        @@keyframes slideIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:none}}

        /* BUTTONS */
        .btn-primary-custom{background:linear-gradient(135deg,var(--orange),#ff8444);color:#fff;border:none;font-weight:700;font-family:'Nunito',sans-serif;border-radius:var(--radius-sm);padding:10px 22px;font-size:.9rem;box-shadow:0 3px 12px rgba(255,107,43,.3);transition:all .22s ease;display:inline-flex;align-items:center;gap:8px;cursor:pointer;text-decoration:none}
        .btn-primary-custom:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(255,107,43,.4);color:#fff}
        .btn-navy{background:var(--navy);color:#fff;border:none;font-weight:700;border-radius:var(--radius-sm);padding:10px 22px;font-size:.9rem;transition:all .22s ease;display:inline-flex;align-items:center;gap:8px;cursor:pointer;text-decoration:none}
        .btn-navy:hover{background:var(--navy-light);color:#fff;transform:translateY(-1px)}
        .btn-ghost{background:var(--gray-100);color:var(--gray-600);border:1px solid var(--gray-200);font-weight:600;border-radius:var(--radius-sm);padding:10px 18px;font-size:.88rem;transition:all .2s ease;display:inline-flex;align-items:center;gap:6px;cursor:pointer;text-decoration:none}
        .btn-ghost:hover{background:var(--gray-200);color:var(--navy)}

        /* CARDS */
        .card{background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius);box-shadow:var(--shadow-sm);transition:box-shadow .25s ease}
        .card:hover{box-shadow:var(--shadow)}

        /* FORMS */
        .form-control,.form-select{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-sm);color:var(--text);font-family:'Nunito',sans-serif;font-size:.9rem;font-weight:500;padding:10px 14px;transition:all .2s ease}
        .form-control:focus,.form-select:focus{border-color:var(--orange);box-shadow:0 0 0 3px rgba(255,107,43,.12);color:var(--text)}
        .form-label{font-size:.75rem;font-weight:800;color:var(--navy);margin-bottom:6px;text-transform:uppercase;letter-spacing:.04em;display:block}

        /* BADGES */
        .badge-pill{padding:5px 12px;border-radius:20px;font-size:.72rem;font-weight:700;display:inline-flex;align-items:center;gap:5px}
        .badge-pill::before{content:'';width:6px;height:6px;border-radius:50%;flex-shrink:0}
        .bp-green{background:#ECFDF5;color:#059669;border:1px solid #A7F3D0}.bp-green::before{background:#059669}
        .bp-red{background:#FEF2F2;color:#DC2626;border:1px solid #FECACA}.bp-red::before{background:#DC2626}
        .bp-yellow{background:#FFFBEB;color:#D97706;border:1px solid #FDE68A}.bp-yellow::before{background:#D97706}
        .bp-blue{background:#EEF2FF;color:#6366F1;border:1px solid #C7D2FE}.bp-blue::before{background:#6366F1}
        .bp-gray{background:var(--gray-100);color:var(--gray-600);border:1px solid var(--gray-200)}.bp-gray::before{background:var(--gray-400)}

        @@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
        .fade-up{animation:fadeUp .5s ease both}

        /* CAR CARD */
        .car-card{background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);transition:all .3s ease}
        .car-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
        .car-img{height:200px;background:var(--gray-100);overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center}
        .car-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
        .car-card:hover .car-img img{transform:scale(1.06)}
        .car-img .no-img{font-size:3.5rem;color:var(--gray-200)}
        .car-img .dispo-pin{position:absolute;top:10px;right:10px}
        .car-body{padding:16px}
        .car-name{font-weight:800;font-size:.97rem;color:var(--navy)}
        .car-meta{font-size:.78rem;color:var(--gray-400);margin-top:2px}
        .car-price{font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:700;color:var(--orange);margin-top:10px}
        .car-footer{padding:12px 16px;border-top:1px solid var(--gray-100);display:flex;gap:8px;align-items:center}

        footer.pub-footer{background:var(--navy);color:rgba(255,255,255,.5);text-align:center;padding:24px;font-size:.82rem;margin-top:60px}
        footer.pub-footer span{color:var(--orange)}
        ::-webkit-scrollbar{width:5px}::-webkit-scrollbar-thumb{background:var(--gray-200);border-radius:3px}
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<!-- NAVBAR -->
<nav class="pub-nav">
    <div class="container" style="max-width:1280px;">
        <a href="@(ViewBag.ClientConnecte != null ? "/Portail/Espace" : "/Portail/Index")" class="nav-brand">
            <div class="nav-brand-icon"><i class="fas fa-car"></i></div>
            <div class="nav-brand-text">CarRental</div>
        </a>
        <div class="nav-links">
            <a href="/Portail/Index" class="@(ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")">
                <i class="fas fa-car-side"></i> Nos voitures
            </a>
            @if (ViewBag.ClientConnecte != null)
            {
                <a href="/Portail/Espace" class="@(ViewContext.RouteData.Values["action"]?.ToString()=="Espace"?"active":"")">
                    <i class="fas fa-user"></i> Mon espace
                </a>
            }
        </div>
        <div class="nav-actions">
            @if (ViewBag.ClientConnecte is CarRental.Models.Client c)
            {
                <div class="client-badge">
                    <div class="client-avatar">@c.Prenom[0]@c.Nom[0]</div>
                    @c.Prenom
                </div>
                <a href="/Portail/Logout" class="btn-ghost" style="padding:7px 14px;font-size:.82rem;">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            }
            else
            {
                <a href="/Portail/Login" class="btn-nav-login"><i class="fas fa-sign-in-alt"></i> Connexion</a>
                <a href="/Portail/Register" class="btn-nav-primary"><i class="fas fa-user-plus"></i> S'inscrire</a>
            }
        </div>
    </div>
</nav>

@if (ViewBag.ClientConnecte is CarRental.Models.Client cu)
{
    <div style="background:linear-gradient(135deg,var(--navy),var(--navy-light));padding:14px 24px;border-bottom:1px solid rgba(255,255,255,.08)">
        <div style="max-width:1280px;margin:0 auto;display:flex;align-items:center;gap:14px">
            <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--orange),#ff8444);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:.85rem;font-weight:800;color:#fff;box-shadow:0 3px 10px rgba(255,107,43,.35);flex-shrink:0">
                @cu.Prenom[0]@cu.Nom[0]
            </div>
            <div style="flex:1;min-width:0">
                <div style="font-weight:800;color:#fff;font-size:.9rem">Bonjour, @cu.Prenom @cu.Nom !</div>
                <div style="font-size:.72rem;color:rgba(255,255,255,.45);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                    @cu.Email · @cu.Telephone
                </div>
            </div>
        </div>
    </div>
}

<!-- TOASTS -->
<div class="toast-wrap">
    @if (TempData["Success"] != null)
    { <div class="toast-item toast-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div> }
    @if (TempData["Error"] != null)
    { <div class="toast-item toast-error"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div> }
</div>

<main>@RenderBody()</main>

<footer class="pub-footer">
    CarRental &copy; @DateTime.Now.Year — <span>Location de voitures au Maroc</span>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
    // Auto-hide toasts
    setTimeout(() => document.querySelectorAll('.toast-item').forEach(t => { t.style.opacity='0'; t.style.transition='opacity .4s'; setTimeout(()=>t.remove(),400); }), 4000);
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
