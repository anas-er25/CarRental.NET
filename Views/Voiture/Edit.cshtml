@model Voiture
@{ ViewData["Title"] = "Modifier la voiture"; }

<div class="page-header">
    <div>
        <div class="page-header-title">Modifier — @Model.Marque @Model.Modele</div>
        <div class="page-header-sub">@Model.Immatriculation · @Model.Annee</div>
    </div>
    <a href="/Voiture/Index" class="btn-ghost"><i class="fas fa-arrow-left"></i> Retour</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><i class="fas fa-pen" style="color:var(--orange);"></i> Modifier les informations</div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImagesJson" id="imagesJsonField" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Marque" class="form-label"></label>
                            <input asp-for="Marque" class="form-control" />
                            <span asp-validation-for="Marque" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Modele" class="form-label"></label>
                            <input asp-for="Modele" class="form-control" />
                            <span asp-validation-for="Modele" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Annee" class="form-label"></label>
                            <input asp-for="Annee" class="form-control" type="number" />
                            <span asp-validation-for="Annee" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Immatriculation" class="form-label"></label>
                            <input asp-for="Immatriculation" class="form-control" />
                            <span asp-validation-for="Immatriculation" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PrixParJour" class="form-label"></label>
                            <div style="position:relative;">
                                <input asp-for="PrixParJour" class="form-control" type="number" step="0.01" style="padding-right:46px;" />
                                <span style="position:absolute;right:12px;top:50%;transform:translateY(-50%);font-size:.78rem;font-weight:700;color:var(--gray-400);">DH</span>
                            </div>
                            <span asp-validation-for="PrixParJour" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Categorie" class="form-label"></label>
                            <select asp-for="Categorie" class="form-select">
                                <option value="Économique">🚗 Économique</option>
                                <option value="Berline">🚙 Berline</option>
                                <option value="SUV">🚕 SUV</option>
                                <option value="Luxe">🏎️ Luxe</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Disponibilité</label>
                            <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--gray-50);border-radius:var(--radius-sm);border:1.5px solid var(--gray-200);">
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="EstDisponible" class="form-check-input" type="checkbox" style="width:40px;height:22px;" />
                                    <label class="form-check-label" style="font-size:.88rem;font-weight:600;color:var(--gray-600);margin-left:6px;">Disponible</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Current images -->
                    @if (Model.Images.Any())
                    {
                        <div class="mt-4">
                            <label class="form-label">Photos actuelles</label>
                            <div class="row g-2" id="currentImgs">
                                @foreach (var img in Model.Images)
                                {
                                    <div class="col-3" id="img_@img.GetHashCode()">
                                        <div style="aspect-ratio:4/3;border-radius:8px;overflow:hidden;border:2px solid var(--gray-200);position:relative;">
                                            <img src="@img" style="width:100%;height:100%;object-fit:cover;" />
                                            <button type="button" onclick="removeImg('@img')" style="position:absolute;top:4px;right:4px;width:22px;height:22px;border-radius:50%;background:rgba(220,38,38,.9);color:#fff;border:none;font-size:.65rem;cursor:pointer;display:flex;align-items:center;justify-content:center;">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Add new images -->
                    <div class="mt-3">
                        <label class="form-label">Ajouter de nouvelles photos</label>
                        <div class="upload-zone" onclick="document.getElementById('imgInput').click()">
                            <i class="fas fa-plus" style="font-size:1.5rem;color:var(--gray-400);margin-bottom:6px;display:block;"></i>
                            <div style="font-size:.85rem;font-weight:600;color:var(--gray-600);">Cliquez pour ajouter</div>
                            <input type="file" id="imgInput" name="ImageFiles" multiple accept="image/*" style="display:none;" onchange="previewNew(this)" />
                        </div>
                        <div id="newPreview" class="row g-2 mt-2"></div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn-primary-custom"><i class="fas fa-save"></i> Mettre à jour</button>
                        <a href="/Voiture/Index" class="btn-ghost">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let removedImgs = [];
        function removeImg(src) {
            removedImgs.push(src);
            // Update hidden field to remove this image
            const field = document.getElementById('imagesJsonField');
            const imgs = field.value.split('|').filter(i => i && !removedImgs.includes(i));
            field.value = imgs.join('|');
            // Hide the element
            const allDivs = document.querySelectorAll('#currentImgs .col-3');
            allDivs.forEach(d => { if(d.querySelector('img')?.src === src || d.querySelector('img')?.getAttribute('src') === src) d.style.display='none'; });
        }
        function previewNew(input) {
            const preview = document.getElementById('newPreview');
            preview.innerHTML = '';
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.innerHTML += `<div class="col-3"><div style="aspect-ratio:4/3;border-radius:8px;overflow:hidden;border:2px dashed var(--orange);"><img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;" /></div></div>`;
                };
                reader.readAsDataURL(file);
            });
        }
    </script>
}
