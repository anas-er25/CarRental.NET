@model Voiture
@{ ViewData["Title"] = "Détails voiture"; }

<div class="page-header">
    <div>
        <div class="page-header-title">@Model.Marque @Model.Modele</div>
        <div class="page-header-sub">@Model.Immatriculation · @Model.Annee · @Model.Categorie</div>
    </div>
    <div style="display:flex;gap:8px;">
        <a href="/Voiture/Edit/@Model.Id" class="btn-primary-custom"><i class="fas fa-pen"></i> Modifier</a>
        <a href="/Voiture/Index" class="btn-ghost"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
</div>

<div class="row g-4">
    <!-- Image gallery -->
    <div class="col-lg-5">
        <div class="card overflow-hidden" style="border-radius:var(--radius);">
            @if (Model.Images.Any())
            {
                <div id="mainImg" style="height:280px;background:var(--gray-100);overflow:hidden;">
                    <img id="mainImgEl" src="@Model.Images.First()" style="width:100%;height:100%;object-fit:cover;transition:opacity .3s ease;" />
                </div>
                @if (Model.Images.Count > 1)
                {
                    <div style="display:flex;gap:8px;padding:12px;background:var(--white);">
                        @foreach (var img in Model.Images)
                        {
                            <div onclick="document.getElementById('mainImgEl').style.opacity='0';setTimeout(()=>{document.getElementById('mainImgEl').src='@img';document.getElementById('mainImgEl').style.opacity='1'},200);"
                                 style="width:60px;height:50px;border-radius:8px;overflow:hidden;border:2px solid var(--gray-200);cursor:pointer;transition:all .2s ease;flex-shrink:0;"
                                 onmouseenter="this.style.borderColor='var(--orange)'" onmouseleave="this.style.borderColor='var(--gray-200)'">
                                <img src="@img" style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div style="height:280px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--gray-100);color:var(--gray-400);">
                    <i class="fas fa-car" style="font-size:4rem;opacity:.25;margin-bottom:12px;"></i>
                    <span style="font-size:.85rem;font-weight:600;">Aucune photo disponible</span>
                </div>
            }
        </div>

        <!-- Stats -->
        <div class="card mt-3">
            <div class="card-body" style="padding:16px;">
                <div style="display:grid;gap:0;">
                    @foreach (var (lbl, val, color) in new[] {
                        ("Immatriculation", Model.Immatriculation, "var(--navy)"),
                        ("Catégorie", Model.Categorie, "var(--navy)"),
                        ("Année", Model.Annee.ToString(), "var(--navy)"),
                        ("Prix par jour", Model.PrixParJour.ToString("N0") + " DH", "var(--orange)")
                    })
                    {
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--gray-100);">
                            <span style="font-size:.8rem;font-weight:700;color:var(--gray-400);text-transform:uppercase;letter-spacing:.04em;">@lbl</span>
                            <span style="font-weight:700;color:@color;">@val</span>
                        </div>
                    }
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;">
                        <span style="font-size:.8rem;font-weight:700;color:var(--gray-400);text-transform:uppercase;letter-spacing:.04em;">Statut</span>
                        @if (Model.EstDisponible) { <span class="badge-pill bp-green">Disponible</span> }
                        else { <span class="badge-pill bp-red">En location</span> }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- History -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div><i class="fas fa-history" style="color:var(--orange);margin-right:8px;"></i>Historique des locations</div>
                <span class="badge-pill bp-blue">@Model.Locations.Count location(s)</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Client</th><th>Dates</th><th>Jours</th><th>Prix</th><th>Dommage</th><th>Statut</th></tr></thead>
                    <tbody>
                        @if (!Model.Locations.Any())
                        {
                            <tr><td colspan="6"><div class="empty-state"><i class="fas fa-history"></i><p>Aucune location</p></div></td></tr>
                        }
                        @foreach (var l in Model.Locations.OrderByDescending(x => x.DateCreation))
                        {
                            <tr>
                                <td style="font-weight:700;">@l.Client?.NomComplet</td>
                                <td style="font-size:.8rem;color:var(--gray-400);">@l.DateDebut.ToString("dd/MM/yy") → @l.DateFin.ToString("dd/MM/yy")</td>
                                <td>@l.NombreJours j</td>
                                <td style="color:var(--orange);font-weight:700;">@l.PrixTotal.ToString("N0") DH</td>
                                <td>
                                    @if (l.ADommage && l.MontantDommage > 0)
                                    {
                                        <span class="badge-pill bp-red" title="@l.DescriptionDommage">+@l.MontantDommage.Value.ToString("N0") DH</span>
                                    }
                                    else { <span style="color:var(--gray-400);font-size:.82rem;">—</span> }
                                </td>
                                <td>
                                    @if (l.Statut == "EnCours") { <span class="badge-pill bp-yellow">En cours</span> }
                                    else if (l.Statut == "Terminée") { <span class="badge-pill bp-green">Terminée</span> }
                                    else { <span class="badge-pill bp-gray">Annulée</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
