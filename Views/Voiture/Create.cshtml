@model Voiture
@{ ViewData["Title"] = "Ajouter une voiture"; }

<div class="page-header">
    <div>
        <div class="page-header-title">Nouvelle Voiture</div>
        <div class="page-header-sub">Remplissez les informations du véhicule</div>
    </div>
    <a href="/Voiture/Index" class="btn-ghost"><i class="fas fa-arrow-left"></i> Retour</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-car-side" style="color:var(--orange);"></i> Informations du véhicule
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Marque" class="form-label"></label>
                            <input asp-for="Marque" class="form-control" placeholder="Ex: Dacia" />
                            <span asp-validation-for="Marque" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Modele" class="form-label"></label>
                            <input asp-for="Modele" class="form-control" placeholder="Ex: Logan" />
                            <span asp-validation-for="Modele" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Annee" class="form-label"></label>
                            <input asp-for="Annee" class="form-control" type="number" placeholder="2023" />
                            <span asp-validation-for="Annee" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Immatriculation" class="form-label"></label>
                            <input asp-for="Immatriculation" class="form-control" placeholder="12345-A-1" />
                            <span asp-validation-for="Immatriculation" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PrixParJour" class="form-label"></label>
                            <div style="position:relative;">
                                <input asp-for="PrixParJour" class="form-control" type="number" step="0.01" placeholder="250" style="padding-right:46px;" />
                                <span style="position:absolute;right:12px;top:50%;transform:translateY(-50%);font-size:.78rem;font-weight:700;color:var(--gray-400);">DH</span>
                            </div>
                            <span asp-validation-for="PrixParJour" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Categorie" class="form-label"></label>
                            <select asp-for="Categorie" class="form-select">
                                <option value="Économique">🚗 Économique</option>
                                <option value="Berline">🚙 Berline</option>
                                <option value="SUV">🚕 SUV</option>
                                <option value="Luxe">🏎️ Luxe</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Disponibilité</label>
                            <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;background:var(--gray-50);border-radius:var(--radius-sm);border:1.5px solid var(--gray-200);">
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="EstDisponible" class="form-check-input" type="checkbox" checked style="width:40px;height:22px;" />
                                    <label class="form-check-label" style="font-size:.88rem;font-weight:600;color:var(--gray-600);margin-left:6px;">Disponible à la location</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Image upload -->
                    <div class="mt-4">
                        <label class="form-label">Photos du véhicule</label>
                        <div class="upload-zone" id="uploadZone" onclick="document.getElementById('imgInput').click()">
                            <i class="fas fa-cloud-upload-alt" style="font-size:2rem;color:var(--gray-400);margin-bottom:8px;display:block;"></i>
                            <div style="font-weight:700;color:var(--navy);font-size:.9rem;">Cliquez ou glissez vos photos ici</div>
                            <div style="font-size:.78rem;color:var(--gray-400);margin-top:4px;">JPG, PNG · Plusieurs fichiers acceptés</div>
                            <input type="file" id="imgInput" name="ImageFiles" multiple accept="image/*" style="display:none;" onchange="previewImages(this)" />
                        </div>
                        <div id="imgPreview" class="row g-2 mt-2"></div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn-primary-custom">
                            <i class="fas fa-save"></i> Enregistrer la voiture
                        </button>
                        <a href="/Voiture/Index" class="btn-ghost">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Tips card -->
    <div class="col-lg-4">
        <div class="card" style="border:1.5px solid #FDE68A;background:linear-gradient(135deg,#FFFBEB,#FEF3C7);">
            <div class="card-header" style="background:transparent;border-color:#FDE68A;color:#92400E;">
                <i class="fas fa-lightbulb" style="color:#D97706;"></i> Conseils
            </div>
            <div class="card-body" style="font-size:.85rem;color:#78350F;line-height:1.7;">
                <p><strong>📸 Photos :</strong> Ajoutez plusieurs angles (avant, arrière, intérieur) pour une meilleure présentation.</p>
                <p class="mt-2"><strong>💰 Prix :</strong> Le prix journalier sera utilisé pour calculer automatiquement le coût total d'une location.</p>
                <p class="mt-2"><strong>🏷️ Catégorie :</strong> Choisissez la catégorie qui correspond le mieux au segment du véhicule.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImages(input) {
            const preview = document.getElementById('imgPreview');
            preview.innerHTML = '';
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.innerHTML += `
                        <div class="col-4">
                            <div style="aspect-ratio:4/3;border-radius:8px;overflow:hidden;border:2px solid var(--gray-200);">
                                <img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                        </div>`;
                };
                reader.readAsDataURL(file);
            });
        }
        // Drag & drop
        const zone = document.getElementById('uploadZone');
        zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag'); });
        zone.addEventListener('dragleave', () => zone.classList.remove('drag'));
        zone.addEventListener('drop', e => {
            e.preventDefault(); zone.classList.remove('drag');
            const inp = document.getElementById('imgInput');
            inp.files = e.dataTransfer.files;
            previewImages(inp);
        });
    </script>
}
