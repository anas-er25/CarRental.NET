@model Voiture
@{ ViewData["Title"] = "Supprimer la voiture"; }

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card" style="border:1.5px solid #FECACA;border-radius:var(--radius);">
            <div class="card-header" style="border-color:#FECACA;background:#FEF2F2;">
                <i class="fas fa-exclamation-triangle" style="color:#DC2626;margin-right:8px;"></i>
                <span style="color:#DC2626;">Confirmer la suppression</span>
            </div>
            <div class="card-body text-center p-4">
                @if (Model.ImagePrincipale != null)
                {
                    <div style="width:80px;height:70px;border-radius:12px;overflow:hidden;margin:0 auto 16px;border:2px solid var(--gray-200);">
                        <img src="@Model.ImagePrincipale" style="width:100%;height:100%;object-fit:cover;" />
                    </div>
                }
                else
                {
                    <div style="width:72px;height:72px;background:#FEF2F2;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:1.6rem;color:#DC2626;">
                        <i class="fas fa-car-side"></i>
                    </div>
                }
                <h5 style="font-family:'Playfair Display',serif;font-weight:700;color:var(--navy);">@Model.Marque @Model.Modele</h5>
                <p style="color:var(--gray-400);font-size:.88rem;">@Model.Immatriculation · @Model.Annee</p>
                <div style="background:#FEF2F2;border-radius:8px;padding:12px;margin:16px 0;font-size:.85rem;color:#DC2626;font-weight:600;">
                    <i class="fas fa-exclamation-circle me-2"></i>Cette action est irréversible. Toutes les données liées seront perdues.
                </div>
                <form asp-action="Delete" method="post" class="d-flex gap-3 justify-content-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn-danger-soft">
                        <i class="fas fa-trash"></i> Supprimer définitivement
                    </button>
                    <a href="/Voiture/Index" class="btn-ghost">Annuler</a>
                </form>
            </div>
        </div>
    </div>
</div>
