@model Client
@{
    ViewData["Title"] = "Ajouter un client"; bool isModal = ViewBag.IsModal == true;
}

@if (!isModal)
{
    <div class="page-header">
        <div>
            <div class="page-header-title">Nouveau Client</div>
            <div class="page-header-sub">Remplissez les informations du client</div>
        </div>
        <a href="/Client/Index" class="btn-ghost"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
}

<div class="@(isModal ? "" : "row justify-content-center")">
    <div class="@(isModal ? "" : "col-lg-7")">
        <div class="@(isModal ? "" : "card")">
            @if (!isModal)
            {
                <div class="card-header"><i class="fas fa-user-plus" style="color:var(--orange);margin-right:8px;"></i>Informations client</div>
            }
            <div class="@(isModal ? "" : "card-body")">
                <form asp-action="Create" method="post" id="clientForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nom" class="form-label"></label>
                            <input asp-for="Nom" class="form-control" placeholder="Alami" />
                            <span asp-validation-for="Nom" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Prenom" class="form-label"></label>
                            <input asp-for="Prenom" class="form-control" placeholder="Youssef" />
                            <span asp-validation-for="Prenom" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CIN" class="form-label"></label>
                            <input asp-for="CIN" class="form-control" placeholder="AB123456" />
                            <span asp-validation-for="CIN" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Telephone" class="form-label"></label>
                            <input asp-for="Telephone" class="form-control" placeholder="0612345678" />
                            <span asp-validation-for="Telephone" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="exemple@email.ma" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:.75rem;"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Adresse" class="form-label"></label>
                            <input asp-for="Adresse" class="form-control" placeholder="Adresse complète (optionnel)" />
                        </div>
                    </div>
                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn-primary-custom">
                            <i class="fas fa-save"></i> Enregistrer
                        </button>
                        @if (!isModal)
                        {
                            <a href="/Client/Index" class="btn-ghost">Annuler</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
