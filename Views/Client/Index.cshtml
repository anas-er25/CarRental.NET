@model IEnumerable<Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="page-header">
    <div>
        <div class="page-header-title">Clients</div>
        <div class="page-header-sub">@Model.Count() client(s) enregistré(s)</div>
    </div>
    <a href="/Client/Create" class="btn-primary-custom"><i class="fas fa-user-plus"></i> Ajouter un client</a>
</div>

<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label">Recherche</label>
            <div style="position:relative;">
                <i class="fas fa-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--gray-400);font-size:.82rem;"></i>
                <input type="text" name="search" class="form-control" style="padding-left:36px;" placeholder="Nom, prénom, CIN, email..." value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2 align-items-end">
            <button type="submit" class="btn-primary-custom flex-fill">Filtrer</button>
            <a href="/Client/Index" class="btn-ghost">✕</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr><th>Client</th><th>CIN</th><th>Téléphone</th><th>Email</th><th>Inscrit le</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6"><div class="empty-state"><i class="fas fa-users"></i><p>Aucun client trouvé</p></div></td></tr>
                }
                @{
                    int i = 0;
                }
                @foreach (var c in Model)
                {
                    <tr style="animation:fadeUp .4s ease @(i * 0.05)s both;">
                        <td>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--navy),var(--navy-light));display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.82rem;color:#fff;flex-shrink:0;">
                                    @c.Prenom[0]@c.Nom[0]
                                </div>
                                <div>
                                    <div style="font-weight:700;color:var(--navy);">@c.NomComplet</div>
                                    @if (c.Adresse != null)
                                    {
                                        <div style="font-size:.75rem;color:var(--gray-400);">@c.Adresse</div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td><span style="font-family:monospace;font-size:.85rem;color:var(--gray-600);background:var(--gray-100);padding:3px 8px;border-radius:6px;">@c.CIN</span></td>
                        <td style="color:var(--gray-600);">@c.Telephone</td>
                        <td style="font-size:.85rem;color:var(--gray-400);">@c.Email</td>
                        <td style="font-size:.82rem;color:var(--gray-400);">@c.DateInscription.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div style="display:flex;gap:6px;">
                                <a href="/Client/Details/@c.Id" class="btn-icon view"><i class="fas fa-eye"></i></a>
                                <a href="/Client/Edit/@c.Id" class="btn-icon edit"><i class="fas fa-pen"></i></a>
                                <a href="/Client/Delete/@c.Id" class="btn-icon del"><i class="fas fa-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>
