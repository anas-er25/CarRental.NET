@model CarRental.Models.Voiture
@{ ViewData["Title"] = Model.Marque + " " + Model.Modele; Layout = "~/Views/Shared/_LayoutPortail.cshtml"; }

<div style="max-width:1000px;margin:40px auto;padding:0 24px">
    <div style="margin-bottom:20px">
        <a href="/Portail/Index" style="color:var(--gray-400);text-decoration:none;font-size:.85rem;font-weight:600"><i class="fas fa-arrow-left me-1"></i>Retour au catalogue</a>
    </div>

    <div class="row g-4">
        <!-- Photo -->
        <div class="col-md-6">
            @if (Model.Images?.Any() == true)
            {
                <div style="border-radius:var(--radius);overflow:hidden;background:var(--gray-100);height:350px">
                    <img src="@Model.ImagePrincipale" style="width:100%;height:100%;object-fit:cover" id="mainImg" />
                </div>
                @if (Model.Images.Count > 1)
                {
                    <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
                        @foreach (var img in Model.Images)
                        {
                            <img src="@img" onclick="document.getElementById('mainImg').src='@img'"
                                 style="width:70px;height:52px;object-fit:cover;border-radius:8px;cursor:pointer;border:2px solid var(--gray-200);transition:border-color .2s ease"
                                 onmouseenter="this.style.borderColor='var(--orange)'" onmouseleave="this.style.borderColor='var(--gray-200)'" />
                        }
                    </div>
                }
            }
            else
            {
                <div style="border-radius:var(--radius);background:var(--gray-100);height:350px;display:flex;align-items:center;justify-content:center;font-size:5rem;color:var(--gray-200)">
                    <i class="fas fa-car"></i>
                </div>
            }
        </div>

        <!-- Info -->
        <div class="col-md-6">
            <div style="margin-bottom:6px">
                <span class="badge-pill bp-green">Disponible</span>
                <span class="badge-pill bp-blue ms-2">@Model.Categorie</span>
            </div>
            <div style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:800;color:var(--navy);margin-bottom:4px">
                @Model.Marque @Model.Modele
            </div>
            <div style="font-size:.88rem;color:var(--gray-400);margin-bottom:20px">
                @Model.Annee · @Model.Immatriculation
            </div>

            <div style="font-family:'Playfair Display',serif;font-size:2.5rem;font-weight:800;color:var(--orange);margin-bottom:6px">
                @Model.PrixParJour.ToString("N0") <span style="font-size:1rem;font-weight:500;color:var(--gray-400)">DH / jour</span>
            </div>

            <!-- Quick date selector -->
            <div style="background:var(--gray-50);border:1px solid var(--gray-200);border-radius:var(--radius);padding:18px;margin-bottom:20px">
                <div style="font-size:.75rem;font-weight:800;color:var(--navy);text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px">Sélectionnez vos dates</div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Départ</label>
                        <input type="date" id="qDateDebut" class="form-control" value="@((ViewBag.DateDebut as DateTime?)?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" min="@DateTime.Today.ToString("yyyy-MM-dd")" oninput="calcQuick()" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Retour</label>
                        <input type="date" id="qDateFin" class="form-control" value="@((ViewBag.DateFin as DateTime?)?.ToString("yyyy-MM-dd") ?? DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" oninput="calcQuick()" />
                    </div>
                </div>
                <div id="quickTotal" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:var(--navy);border-radius:8px;color:#fff">
                    <span style="font-size:.82rem;opacity:.6">Estimation</span>
                    <span id="qTotalVal" style="font-family:'Playfair Display',serif;font-weight:800;color:var(--orange-light);font-size:1.2rem">— DH</span>
                </div>
            </div>

            <a id="reserverBtn" href="/Portail/Demande/@Model.Id" class="btn-primary-custom w-100" style="justify-content:center;padding:14px;font-size:.95rem;margin-bottom:10px">
                <i class="fas fa-key"></i> Réserver ce véhicule
            </a>
            <a href="/Portail/Index" class="btn-ghost w-100" style="justify-content:center;padding:12px;font-size:.88rem">
                <i class="fas fa-search"></i> Voir d'autres véhicules
            </a>
        </div>
    </div>

    <!-- Features -->
    <div style="margin-top:36px;background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius);padding:24px">
        <div style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--navy);margin-bottom:18px">Ce qui est inclus</div>
        <div class="row g-3">
            @foreach (var (ico,titre,desc) in new[]{
                ("fas fa-shield-alt","Assurance complète","Couverte pour toute la durée"),
                ("fas fa-road","Kilométrage illimité","Roulez sans compteur"),
                ("fas fa-headset","Assistance 24/7","Nous sommes toujours là"),
                ("fas fa-undo-alt","Annulation flexible","Jusqu'à 24h avant"),
            })
            {
                <div class="col-6 col-md-3">
                    <div style="display:flex;align-items:flex-start;gap:12px">
                        <div style="width:36px;height:36px;border-radius:9px;background:#FFF7ED;display:flex;align-items:center;justify-content:center;font-size:.85rem;color:var(--orange);flex-shrink:0">
                            <i class="@ico"></i>
                        </div>
                        <div>
                            <div style="font-weight:700;font-size:.88rem;color:var(--navy)">@titre</div>
                            <div style="font-size:.78rem;color:var(--gray-400);margin-top:2px">@desc</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
const prix = @Model.PrixParJour;
function calcQuick() {
    const d1 = new Date(document.getElementById('qDateDebut').value);
    const d2 = new Date(document.getElementById('qDateFin').value);
    const j = Math.round((d2-d1)/86400000);
    if (j > 0) {
        document.getElementById('qTotalVal').textContent = (j*prix).toLocaleString('fr-MA') + ' DH (' + j + 'j)';
        document.getElementById('reserverBtn').href = `/Portail/Demande/@Model.Id?dateDebut=${document.getElementById('qDateDebut').value}&dateFin=${document.getElementById('qDateFin').value}`;
    }
}
calcQuick();
</script>
}
