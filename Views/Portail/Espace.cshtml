@model EspaceClientViewModel
@{ ViewData["Title"] = "Mon Espace"; Layout = "~/Views/Shared/_LayoutPortail.cshtml"; }

<div style="max-width:1100px;margin:0 auto;padding:32px 24px">

    @if (!Model.Client.CompteActif)
    {
        <div style="background:#FEF2F2;border:1.5px solid #FECACA;border-radius:var(--radius);padding:14px 20px;margin-bottom:20px;display:flex;align-items:center;gap:12px">
            <i class="fas fa-ban" style="color:#DC2626;font-size:1.1rem"></i>
            <div style="font-weight:700;color:#B91C1C;font-size:.9rem">Compte désactivé — Contactez l'administrateur</div>
        </div>
    }
    <!-- Stats -->
    <div class="row g-3 mb-4">
        @foreach (var (val, lbl, ico, bg, col) in new[]{
            (Model.LocActives.ToString(), "Locations actives", "fas fa-key", "#FFF7ED", "var(--orange)"),
            (Model.LocTerminees.ToString(), "Terminées", "fas fa-check-circle", "#ECFDF5", "#059669"),
            (Model.Demandes.Count(d=>d.Statut=="EnAttente").ToString(), "En attente", "fas fa-clock", "#FFFBEB", "#D97706"),
            (Model.TotalDepense.ToString("N0")+" DH", "Total dépensé", "fas fa-receipt", "#EEF2FF", "#6366F1")
        })
        {
            <div class="col-6 col-md-3">
                <div style="background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow-sm);animation:fadeUp .4s ease">
                    <div style="width:38px;height:38px;background:@bg;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.9rem;color:@col;margin-bottom:10px">
                        <i class="@ico"></i>
                    </div>
                    <div style="font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:800;color:var(--navy)">@val</div>
                    <div style="font-size:.72rem;font-weight:700;color:var(--gray-400);text-transform:uppercase;letter-spacing:.04em;margin-top:3px">@lbl</div>
                </div>
            </div>
        }
    </div>

    <!-- Actions rapides -->
    <div style="display:flex;gap:10px;margin-bottom:28px;flex-wrap:wrap">
        <a href="#voitures-disponibles" class="btn-primary-custom"><i class="fas fa-car"></i> Réserver une voiture</a>
        <a href="/Portail/Profil" class="btn-ghost"><i class="fas fa-user-edit"></i> Mon profil</a>
    </div>

    <!-- Locations en cours -->
    @if (Model.LocActives > 0)
    {
        <div style="margin-bottom:28px">
            <div style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--navy);margin-bottom:14px">
                <i class="fas fa-key" style="color:var(--orange);margin-right:8px"></i>Locations en cours
            </div>
            <div class="row g-3">
                @foreach (var loc in Model.Locations.Where(l => l.Statut == "EnCours"))
                {
                    <div class="col-md-6">
                        <div style="background:linear-gradient(135deg,var(--navy),var(--navy-light));border-radius:var(--radius);padding:20px;color:#fff">
                            <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:12px">
                                <div>
                                    <div style="font-weight:800;font-size:.95rem">@loc.Voiture?.Marque @loc.Voiture?.Modele</div>
                                    <div style="font-size:.78rem;opacity:.6">@loc.Voiture?.Immatriculation</div>
                                </div>
                                <span class="badge-pill bp-yellow">En cours</span>
                            </div>
                            <div style="display:flex;gap:16px;font-size:.82rem;opacity:.7;margin-bottom:14px">
                                <span><i class="fas fa-calendar me-1"></i>@loc.DateDebut.ToString("dd/MM")</span>
                                <span>→</span>
                                <span>@loc.DateFin.ToString("dd/MM/yyyy")</span>
                                <span>(@loc.NombreJours j)</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;align-items:center">
                                <div style="font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:800;color:var(--orange-light)">@loc.PrixTotal.ToString("N0") DH</div>
                                <a href="/Portail/DetailLocation/@loc.Id" style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:8px;padding:6px 14px;font-size:.78rem;font-weight:700;color:#fff;text-decoration:none">
                                    <i class="fas fa-eye me-1"></i>Détails
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Demandes -->
    @if (Model.Demandes.Any())
    {
        <div style="margin-bottom:28px">
            <div style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--navy);margin-bottom:14px">
                <i class="fas fa-clock" style="color:#D97706;margin-right:8px"></i>Mes demandes
            </div>
            <div style="background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius);overflow:hidden">
                <table style="width:100%;border-collapse:collapse">
                    <thead>
                        <tr style="background:var(--gray-50)">
                            <th style="padding:12px 16px;font-size:.7rem;font-weight:800;color:var(--gray-400);text-transform:uppercase;text-align:left">Voiture</th>
                            <th style="padding:12px 16px;font-size:.7rem;font-weight:800;color:var(--gray-400);text-transform:uppercase;text-align:left">Période</th>
                            <th style="padding:12px 16px;font-size:.7rem;font-weight:800;color:var(--gray-400);text-transform:uppercase;text-align:left">Statut</th>
                            <th style="padding:12px 16px;font-size:.7rem;font-weight:800;color:var(--gray-400);text-transform:uppercase;text-align:left">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Demandes)
                        {
                            <tr style="border-top:1px solid var(--gray-100)">
                                <td style="padding:12px 16px;font-weight:700;font-size:.88rem;color:var(--navy)">@d.Voiture?.Marque @d.Voiture?.Modele</td>
                                <td style="padding:12px 16px;font-size:.82rem;color:var(--gray-400)">@d.DateDebut.ToString("dd/MM") → @d.DateFin.ToString("dd/MM/yy")</td>
                                <td style="padding:12px 16px">
                                    @switch (d.Statut)
                                    {
                                        case "EnAttente": <span class="badge-pill bp-yellow">En attente</span> break;
                                        case "Confirmee": <span class="badge-pill bp-green">Confirmée ✓</span> break;
                                        case "Rejetee": <span class="badge-pill bp-red">Non confirmée</span> break;
                                        default: <span class="badge-pill bp-gray">@d.Statut</span> break;
                                    }
                                </td>
                                <td style="padding:12px 16px;font-size:.78rem;color:var(--gray-400)">@d.DateDemande.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Historique locations -->
    <div style="margin-bottom:40px">
        <div style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--navy);margin-bottom:14px">
            <i class="fas fa-history" style="color:var(--gray-400);margin-right:8px"></i>Historique des locations
        </div>
        @if (!Model.Locations.Any(l => l.Statut == "Terminée"))
        {
            <div style="text-align:center;padding:40px;color:var(--gray-400)">
                <i class="fas fa-history" style="font-size:2.5rem;opacity:.2;display:block;margin-bottom:12px"></i>
                <p style="font-weight:600">Aucune location terminée</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var loc in Model.Locations.Where(l => l.Statut == "Terminée").OrderByDescending(l => l.DateFin))
                {
                    <div class="col-md-6">
                        <div style="background:var(--white);border:1px solid var(--gray-200);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow-sm)">
                            <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:10px">
                                <div>
                                    <div style="font-weight:800;color:var(--navy)">@loc.Voiture?.Marque @loc.Voiture?.Modele</div>
                                    <div style="font-size:.78rem;color:var(--gray-400)">@loc.DateDebut.ToString("dd/MM") → @loc.DateFin.ToString("dd/MM/yyyy") · @loc.NombreJours j</div>
                                </div>
                                <div style="font-family:'Playfair Display',serif;font-weight:700;color:var(--orange);font-size:1rem">@loc.TotalAvecDommage.ToString("N0") DH</div>
                            </div>
                            <div style="display:flex;gap:8px">
                                <a href="/Portail/DetailLocation/@loc.Id" class="btn-ghost" style="flex:1;justify-content:center;font-size:.78rem;padding:6px 10px">
                                    <i class="fas fa-eye"></i> Détails
                                </a>
                                <a href="/Portail/Facture/@loc.Id" class="btn-primary-custom" style="flex:1;justify-content:center;font-size:.78rem;padding:6px 10px">
                                    <i class="fas fa-file-invoice"></i> Facture
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Voitures disponibles -->
    @if (Model.VoituresDisponibles.Any())
    {
        <div id="voitures-disponibles" style="padding-top:12px">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px">
                <div>
                    <div style="font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:800;color:var(--navy)">
                        <i class="fas fa-car" style="color:var(--orange);margin-right:8px"></i>Voitures disponibles
                    </div>
                    <div style="font-size:.82rem;color:var(--gray-400);margin-top:3px">
                        @Model.VoituresDisponibles.Count voiture(s) prête(s) à louer
                    </div>
                </div>
            </div>
            <div class="row g-3">
                @foreach (var v in Model.VoituresDisponibles)
                {
                    <div class="col-sm-6 col-lg-4 fade-up">
                        <div class="car-card">
                            <div class="car-img">
                                @if (v.ImagePrincipale != null)
                                {
                                    <img src="@v.ImagePrincipale" alt="@v.Marque @v.Modele"
                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                                    <i class="fas fa-car no-img" style="display:none"></i>
                                }
                                else
                                {
                                    <i class="fas fa-car no-img"></i>
                                }
                                <div class="dispo-pin"><span class="badge-pill bp-green">Disponible</span></div>
                            </div>
                            <div class="car-body">
                                <div class="car-name">@v.Marque @v.Modele</div>
                                <div class="car-meta">@v.Annee · @v.Categorie · @v.Immatriculation</div>
                                <div class="car-price">@v.PrixParJour.ToString("N0") <span style="font-size:.75rem;font-weight:500;color:var(--gray-400)">DH/jour</span></div>
                            </div>
                            <div class="car-footer">
                                <a href="/Portail/Voiture/@v.Id" class="btn-ghost" style="flex:1;justify-content:center;font-size:.82rem;padding:8px">
                                    <i class="fas fa-eye"></i> Détails
                                </a>
                                <a href="/Portail/Demande/@v.Id" class="btn-primary-custom" style="flex:1;justify-content:center;font-size:.82rem;padding:8px">
                                    <i class="fas fa-calendar-check"></i> Réserver
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div id="voitures-disponibles" style="text-align:center;padding:50px 20px;color:var(--gray-400)">
            <i class="fas fa-car-side" style="font-size:3rem;opacity:.2;display:block;margin-bottom:14px"></i>
            <div style="font-weight:700;font-size:.95rem">Aucune voiture disponible pour le moment</div>
            <p style="font-size:.85rem;margin-top:6px">Revenez bientôt pour de nouvelles disponibilités.</p>
        </div>
    }
</div>
