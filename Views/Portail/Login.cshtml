@{ ViewData["Title"] = "Connexion Client"; Layout = "~/Views/Shared/_LayoutPortail.cshtml"; }

<div style="min-height:calc(100vh - 130px);display:flex;align-items:center;justify-content:center;padding:40px 24px;background:linear-gradient(135deg,var(--gray-50) 0%,#EEF2FF 100%)">
    <div style="width:100%;max-width:440px">
        <!-- Logo -->
        <div style="text-align:center;margin-bottom:32px">
            <div style="width:56px;height:56px;background:linear-gradient(135deg,var(--orange),#ff8444);border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;box-shadow:0 6px 20px rgba(255,107,43,.3);margin:0 auto 14px">
                <i class="fas fa-car"></i>
            </div>
            <div style="font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:800;color:var(--navy)">Connexion</div>
            <div style="font-size:.88rem;color:var(--gray-400);margin-top:4px">Accédez à votre espace client</div>
        </div>

        <div style="background:var(--white);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow-lg);border:1px solid var(--gray-200)">
            @if (ViewBag.Error != null)
            {
                <div style="background:#FEF2F2;border:1.5px solid #FECACA;border-radius:var(--radius-sm);padding:12px 16px;font-size:.85rem;font-weight:700;color:#DC2626;display:flex;align-items:center;gap:8px;margin-bottom:20px;animation:shake .4s ease">
                    <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
                </div>
            }

            <form method="post" action="/Portail/Login">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div style="margin-bottom:18px">
                    <label class="form-label">Email</label>
                    <div style="position:relative">
                        <i class="fas fa-envelope" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--gray-400);font-size:.85rem"></i>
                        <input type="email" name="email" class="form-control" style="padding-left:38px" placeholder="votre@email.ma" required />
                    </div>
                </div>

                <div style="margin-bottom:24px">
                    <label class="form-label">Mot de passe</label>
                    <div style="position:relative">
                        <i class="fas fa-lock" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--gray-400);font-size:.85rem"></i>
                        <input type="password" name="password" id="pwd" class="form-control" style="padding-left:38px;padding-right:42px" placeholder="••••••••" required />
                        <button type="button" onclick="this.previousElementSibling.type=this.previousElementSibling.type=='password'?'text':'password';this.querySelector('i').className=this.previousElementSibling.type=='password'?'fas fa-eye':'fas fa-eye-slash'" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--gray-400)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-primary-custom w-100" style="justify-content:center;padding:13px">
                    <i class="fas fa-sign-in-alt"></i> Se connecter
                </button>
            </form>

            <div style="text-align:center;margin-top:20px;padding-top:20px;border-top:1px solid var(--gray-100);font-size:.85rem;color:var(--gray-400)">
                Pas encore de compte ?
                <a href="/Portail/Register" style="color:var(--orange);font-weight:700;text-decoration:none">S'inscrire gratuitement</a>
            </div>
        </div>

        <div style="text-align:center;margin-top:16px">
            <a href="/Portail/Index" style="font-size:.82rem;color:var(--gray-400);text-decoration:none">
                <i class="fas fa-arrow-left"></i> Continuer sans compte
            </a>
        </div>
    </div>
</div>

@section Scripts {
<style>
@@keyframes shake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-8px)} 40%{transform:translateX(8px)} 60%{transform:translateX(-5px)} 80%{transform:translateX(5px)} }
</style>
}
