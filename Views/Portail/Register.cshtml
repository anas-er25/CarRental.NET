@model CarRental.Models.Client
@{ ViewData["Title"] = "Créer un compte"; Layout = "~/Views/Shared/_LayoutPortail.cshtml"; }

<div style="min-height:calc(100vh - 130px);display:flex;align-items:center;justify-content:center;padding:40px 24px;background:linear-gradient(135deg,var(--gray-50) 0%,#EEF2FF 100%)">
    <div style="width:100%;max-width:520px">
        <div style="text-align:center;margin-bottom:32px">
            <div style="width:56px;height:56px;background:linear-gradient(135deg,var(--navy),var(--navy-light));border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:#fff;box-shadow:0 6px 20px rgba(15,32,68,.25);margin:0 auto 14px">
                <i class="fas fa-user-plus"></i>
            </div>
            <div style="font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:800;color:var(--navy)">Créer un compte</div>
            <div style="font-size:.88rem;color:var(--gray-400);margin-top:4px">Réservez plus facilement avec votre espace personnel</div>
        </div>

        <div style="background:var(--white);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow-lg);border:1px solid var(--gray-200)">
            <form method="post" action="/Portail/Register">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label">Nom *</label>
                        <input asp-for="Nom" class="form-control" placeholder="Alami" />
                        <span asp-validation-for="Nom" class="text-danger" style="font-size:.75rem"></span>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Prénom *</label>
                        <input asp-for="Prenom" class="form-control" placeholder="Youssef" />
                        <span asp-validation-for="Prenom" class="text-danger" style="font-size:.75rem"></span>
                    </div>
                    <div class="col-6">
                        <label class="form-label">CIN *</label>
                        <input asp-for="CIN" class="form-control" placeholder="AB123456" />
                        <span asp-validation-for="CIN" class="text-danger" style="font-size:.75rem"></span>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Téléphone *</label>
                        <input asp-for="Telephone" class="form-control" placeholder="0612345678" />
                        <span asp-validation-for="Telephone" class="text-danger" style="font-size:.75rem"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email *</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="exemple@email.ma" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:.75rem"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Adresse</label>
                        <input asp-for="Adresse" class="form-control" placeholder="Adresse complète (optionnel)" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Mot de passe *</label>
                        <input type="password" name="password" class="form-control" placeholder="••••••••" required minlength="6" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Confirmer *</label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required />
                        <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("confirmPassword")</span>
                    </div>
                </div>

                <button type="submit" class="btn-navy w-100 mt-4" style="justify-content:center;padding:13px">
                    <i class="fas fa-user-check"></i> Créer mon compte
                </button>
            </form>

            <div style="text-align:center;margin-top:16px;padding-top:16px;border-top:1px solid var(--gray-100);font-size:.85rem;color:var(--gray-400)">
                Déjà inscrit ?
                <a href="/Portail/Login" style="color:var(--orange);font-weight:700;text-decoration:none">Se connecter</a>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
