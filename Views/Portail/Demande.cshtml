@model DemandeLocationViewModel
@{ ViewData["Title"] = "Réserver"; Layout = "~/Views/Shared/_LayoutPortail.cshtml"; }

<div style="max-width:920px;margin:40px auto;padding:0 24px">
    <div style="margin-bottom:24px">
        <a href="/Portail/Index" style="color:var(--gray-400);text-decoration:none;font-size:.85rem;font-weight:600">
            <i class="fas fa-arrow-left"></i> Retour au catalogue
        </a>
        <div style="font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:800;color:var(--navy);margin-top:10px">
            Réserver — @Model.Voiture?.Marque @Model.Voiture?.Modele
        </div>
    </div>

    <div class="row g-4">
        <!-- FORM -->
        <div class="col-lg-7">
            <form method="post" action="/Portail/Demande">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Demande.VoitureId" value="@Model.Demande.VoitureId" />

                <!-- Dates -->
                <div class="card" style="margin-bottom:20px">
                    <div style="padding:20px 22px;border-bottom:1px solid var(--gray-100)">
                        <div style="font-weight:800;color:var(--navy);font-size:.95rem">
                            <i class="fas fa-calendar" style="color:var(--orange);margin-right:8px"></i>Dates de location
                        </div>
                    </div>
                    <div style="padding:20px 22px">
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label">Date de départ</label>
                                <input type="date" name="Demande.DateDebut" class="form-control"
                                    value="@Model.Demande.DateDebut.ToString("yyyy-MM-dd")"
                                    min="@DateTime.Today.ToString("yyyy-MM-dd")" id="dateDebut" />
                                <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("Demande.DateDebut")</span>
                            </div>
                            <div class="col-6">
                                <label class="form-label">Date de retour</label>
                                <input type="date" name="Demande.DateFin" class="form-control"
                                    value="@Model.Demande.DateFin.ToString("yyyy-MM-dd")"
                                    min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" id="dateFin" />
                                <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("Demande.DateFin")</span>
                            </div>
                        </div>
                        <!-- Price preview -->
                        <div id="pricePreview" style="margin-top:14px;background:linear-gradient(135deg,var(--navy),var(--navy-light));border-radius:10px;padding:14px 18px;color:#fff;display:none">
                            <div style="display:flex;justify-content:space-between;align-items:center">
                                <div>
                                    <div style="font-size:.7rem;opacity:.5;text-transform:uppercase;letter-spacing:.08em">Total estimé</div>
                                    <div id="totalPrice" style="font-family:'Playfair Display',serif;font-size:1.8rem;font-weight:800;color:var(--orange-light)"></div>
                                </div>
                                <div style="text-align:right;font-size:.82rem;opacity:.6">
                                    <span id="jours"></span> jour(s)<br/>× @Model.Voiture?.PrixParJour.ToString("N0") DH/j
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">Remarques (optionnel)</label>
                            <textarea name="Demande.Remarques" class="form-control" rows="2" placeholder="Informations complémentaires...">@Model.Demande.Remarques</textarea>
                        </div>
                    </div>
                </div>

                <!-- Client info -->
                @if (Model.EstAuthentifie && Model.ClientConnecte != null)
                {
                    <!-- Client connecté -->
                    <div class="card" style="margin-bottom:20px;border:1.5px solid #A7F3D0">
                        <div style="padding:16px 22px;background:linear-gradient(135deg,#ECFDF5,#D1FAE5);border-radius:calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0">
                            <div style="display:flex;align-items:center;gap:12px">
                                <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--navy),var(--navy-light));display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff">
                                    @Model.ClientConnecte.Prenom[0]@Model.ClientConnecte.Nom[0]
                                </div>
                                <div>
                                    <div style="font-weight:800;color:#065F46">@Model.ClientConnecte.NomComplet</div>
                                    <div style="font-size:.78rem;color:#059669">Connecté — @Model.ClientConnecte.Email</div>
                                </div>
                                <span class="badge-pill bp-green ms-auto">Compte vérifié</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Client non connecté -->
                    <div class="card" style="margin-bottom:20px">
                        <div style="padding:18px 22px;border-bottom:1px solid var(--gray-100)">
                            <div style="font-weight:800;color:var(--navy);font-size:.95rem">
                                <i class="fas fa-user" style="color:var(--orange);margin-right:8px"></i>Vos informations
                            </div>
                            <div style="margin-top:12px;display:flex;border:1.5px solid var(--gray-200);border-radius:10px;overflow:hidden">
                                    <label id="tabNouveauLabel" style="flex:1;cursor:pointer;text-align:center;padding:10px 0;font-weight:700;font-size:.85rem;transition:all .2s ease">
                                        <input type="radio" name="Mode" value="nouveau" id="modeNouveau" style="display:none"
                                               @(Model.Mode == "connexion" ? "" : "checked") />
                                        <i class="fas fa-user-plus" style="margin-right:5px"></i>Nouveau client
                                    </label>
                                    <label id="tabConnexionLabel" style="flex:1;cursor:pointer;text-align:center;padding:10px 0;font-weight:700;font-size:.85rem;border-left:1.5px solid var(--gray-200);transition:all .2s ease">
                                        <input type="radio" name="Mode" value="connexion" id="modeConnexion" style="display:none"
                                               @(Model.Mode == "connexion" ? "checked" : "") />
                                        <i class="fas fa-sign-in-alt" style="margin-right:5px"></i>Se connecter
                                    </label>
                                </div>
                        </div>

                        <!-- Mode NOUVEAU CLIENT -->
                        <div id="formNouveau" style="padding:20px 22px">
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="form-label">Nom *</label>
                                    <input type="text" name="Demande.NomDemandeur" class="form-control" placeholder="Alami" value="@Model.Demande.NomDemandeur" />
                                    <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("Demande.NomDemandeur")</span>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Prénom *</label>
                                    <input type="text" name="Demande.PrenomDemandeur" class="form-control" placeholder="Youssef" value="@Model.Demande.PrenomDemandeur" />
                                    <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("Demande.PrenomDemandeur")</span>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">CIN *</label>
                                    <input type="text" name="Demande.CINDemandeur" class="form-control" placeholder="AB123456" value="@Model.Demande.CINDemandeur" />
                                    <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("Demande.CINDemandeur")</span>
                                </div>
                                <div class="col-6">
                                    <label class="form-label">Téléphone *</label>
                                    <input type="text" name="Demande.TelephoneDemandeur" class="form-control" placeholder="0612345678" value="@Model.Demande.TelephoneDemandeur" />
                                    <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("Demande.TelephoneDemandeur")</span>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Email *</label>
                                    <input type="email" name="Demande.EmailDemandeur" class="form-control" placeholder="exemple@email.ma" value="@Model.Demande.EmailDemandeur" />
                                    <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("Demande.EmailDemandeur")</span>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Adresse</label>
                                    <input type="text" name="Demande.AdresseDemandeur" class="form-control" placeholder="Adresse complète (optionnel)" value="@Model.Demande.AdresseDemandeur" />
                                </div>
                            </div>

                            <!-- Password fields for account creation -->
                            <div style="margin-top:18px;padding-top:18px;border-top:2px dashed var(--gray-200)">
                                <div style="font-size:.85rem;color:var(--navy);font-weight:800;margin-bottom:12px">
                                    <i class="fas fa-lock" style="color:var(--orange);margin-right:6px"></i>Créer un compte et réserver *
                                </div>
                                <div style="font-size:.78rem;color:var(--gray-400);margin-bottom:12px;padding:10px;background:var(--gray-50);border-radius:8px">
                                    <i class="fas fa-info-circle"></i> Vous pourrez suivre vos réservations et gérer votre profil.
                                </div>
                                <div class="row g-3">
                                    <div class="col-6">
                                        <label class="form-label">Mot de passe *</label>
                                        <input type="password" name="Demande.MotDePasseDemandeur" class="form-control" placeholder="Au moins 6 caractères" />
                                        <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("Demande.MotDePasseDemandeur")</span>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label">Confirmer mot de passe *</label>
                                        <input type="password" name="Demande.ConfirmMotDePasse" class="form-control" placeholder="Confirmer" />
                                        <span class="text-danger" style="font-size:.75rem">@Html.ValidationMessage("Demande.ConfirmMotDePasse")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Mode CONNEXION -->
                        <div id="formConnexion" style="padding:20px 22px;display:none">
                            <div style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border:1.5px solid #BFDBFE;border-radius:10px;padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:12px">
                                <i class="fas fa-shield-alt" style="font-size:1.2rem;color:#2563EB"></i>
                                <div>
                                    <div style="font-size:.88rem;color:#1E40AF;font-weight:800">Connexion à votre compte</div>
                                    <div style="font-size:.75rem;color:#3B82F6;margin-top:2px">Votre réservation sera envoyée automatiquement après connexion.</div>
                                </div>
                            </div>
                            @{
                                var loginErr = ViewData.ModelState["LoginEmail"]?.Errors.FirstOrDefault()?.ErrorMessage;
                            }
                            @if (!string.IsNullOrEmpty(loginErr))
                            {
                                <div style="background:#FEF2F2;border:1.5px solid #FECACA;border-radius:8px;padding:10px 14px;margin-bottom:14px;font-size:.84rem;color:#DC2626;display:flex;align-items:center;gap:8px">
                                    <i class="fas fa-exclamation-circle"></i> @loginErr
                                </div>
                            }
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Email *</label>
                                    <input type="email" name="LoginEmail" id="loginEmail" class="form-control" placeholder="votre@email.ma"
                                           value="@Model.LoginEmail" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Mot de passe *</label>
                                    <input type="password" name="LoginPassword" id="loginPassword" class="form-control" placeholder="Votre mot de passe" />
                                </div>
                            </div>
                            <div style="margin-top:14px;display:flex;justify-content:space-between;align-items:center">
                                <span style="font-size:.8rem;color:var(--gray-400)">Pas encore de compte ?</span>
                                <a href="/Portail/Register" style="font-size:.8rem;color:var(--orange);font-weight:700">
                                    <i class="fas fa-user-plus" style="margin-right:4px"></i>S'inscrire
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <button type="submit" id="submitBtn" class="btn-primary-custom w-100" style="justify-content:center;padding:14px;font-size:.95rem">
                    <i class="fas fa-paper-plane"></i> Envoyer la demande de réservation
                </button>
                <p style="font-size:.75rem;color:var(--gray-400);text-align:center;margin-top:10px">
                    <i class="fas fa-info-circle"></i> L'administrateur vous contactera pour confirmation. Aucun paiement requis maintenant.
                </p>
            </form>
        </div>

        <!-- SUMMARY -->
        <div class="col-lg-5">
            <div class="card" style="position:sticky;top:80px">
                @if (Model.Voiture?.ImagePrincipale != null)
                {
                    <div style="height:180px;overflow:hidden;border-radius:calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0">
                        <img src="@Model.Voiture.ImagePrincipale" style="width:100%;height:100%;object-fit:cover" />
                    </div>
                }
                <div style="padding:18px">
                    <div style="font-weight:800;font-size:1.05rem;color:var(--navy)">@Model.Voiture?.Marque @Model.Voiture?.Modele</div>
                    <div style="font-size:.82rem;color:var(--gray-400);margin-top:3px">@Model.Voiture?.Annee · @Model.Voiture?.Categorie · @Model.Voiture?.Immatriculation</div>
                    <div style="font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:700;color:var(--orange);margin-top:10px">
                        @Model.Voiture?.PrixParJour.ToString("N0") <span style="font-size:.8rem;font-weight:400;color:var(--gray-400)">DH / jour</span>
                    </div>
                    <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--gray-100)">
                        <div style="font-size:.75rem;font-weight:800;color:var(--gray-400);text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px">Ce que vous obtenez</div>
                        @foreach (var feat in new[]{"Assurance incluse","Kilométrage illimité","Assistance 24/7","Annulation flexible"})
                        {
                            <div style="font-size:.82rem;color:var(--gray-600);display:flex;align-items:center;gap:8px;margin-bottom:6px">
                                <i class="fas fa-check-circle" style="color:#059669;font-size:.75rem"></i>@feat
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const prix = @(Model.Voiture?.PrixParJour.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0");

    // ── Calcul prix ──
    function calcPrix() {
        const d1 = new Date(document.getElementById('dateDebut').value);
        const d2 = new Date(document.getElementById('dateFin').value);
        const j = Math.round((d2 - d1) / 86400000);
        const box = document.getElementById('pricePreview');
        if (j > 0) {
            document.getElementById('jours').textContent = j;
            document.getElementById('totalPrice').textContent = (j * prix).toLocaleString('fr-MA') + ' DH';
            box.style.display = 'block';
        } else {
            box.style.display = 'none';
        }
    }
    document.getElementById('dateDebut')?.addEventListener('change', calcPrix);
    document.getElementById('dateFin')?.addEventListener('change', calcPrix);
    calcPrix();

    // ── Toggle Nouveau / Connexion ──
    const tabNouveauLabel    = document.getElementById('tabNouveauLabel');
    const tabConnexionLabel  = document.getElementById('tabConnexionLabel');
    const modeNouveau        = document.getElementById('modeNouveau');
    const modeConnexion      = document.getElementById('modeConnexion');
    const formNouveau        = document.getElementById('formNouveau');
    const formConnexion      = document.getElementById('formConnexion');
    const submitBtn          = document.getElementById('submitBtn');

    if (!modeNouveau) return; // Client déjà connecté, pas besoin du toggle

    function applyTabStyle(isConnexion) {
        if (isConnexion) {
            tabConnexionLabel.style.background  = 'var(--navy)';
            tabConnexionLabel.style.color       = '#fff';
            tabNouveauLabel.style.background    = 'transparent';
            tabNouveauLabel.style.color         = 'var(--gray-600)';
            formNouveau.style.display    = 'none';
            formConnexion.style.display  = 'block';
            if (submitBtn) submitBtn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Se connecter et réserver';
            // Focus email
            const emailInput = document.getElementById('loginEmail');
            if (emailInput) setTimeout(() => emailInput.focus(), 100);
        } else {
            tabNouveauLabel.style.background    = 'var(--navy)';
            tabNouveauLabel.style.color         = '#fff';
            tabConnexionLabel.style.background  = 'transparent';
            tabConnexionLabel.style.color       = 'var(--gray-600)';
            formNouveau.style.display    = 'block';
            formConnexion.style.display  = 'none';
            if (submitBtn) submitBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Créer mon compte et réserver';
        }
    }

    // État initial basé sur le radio coché
    applyTabStyle(modeConnexion.checked);

    // Événements de changement
    modeNouveau.addEventListener('change',   () => applyTabStyle(false));
    modeConnexion.addEventListener('change', () => applyTabStyle(true));

    // Clic sur les labels (pour les radio cachés)
    tabNouveauLabel.addEventListener('click',   () => { modeNouveau.checked   = true;  applyTabStyle(false); });
    tabConnexionLabel.addEventListener('click', () => { modeConnexion.checked = true;  applyTabStyle(true);  });
});
</script>
}
